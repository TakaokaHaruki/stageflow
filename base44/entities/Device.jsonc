{
  "name": "Device",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "\u7aef\u672b\u8a8d\u8a3c\u30c8\u30fc\u30af\u30f3\uff08UUID\uff09"
    },
    "label": {
      "type": "string",
      "description": "\u7aef\u672b\u540d"
    },
    "scope": {
      "type": "string",
      "enum": [
        "shared",
        "user"
      ],
      "default": "shared",
      "description": "\u5229\u7528\u7bc4\u56f2\uff08shared=\u5168\u793e\u5171\u901a / user=\u500b\u4eba\u7528\uff09"
    },
    "target_user_id": {
      "type": "string",
      "default": "",
      "description": "\u500b\u4eba\u7528\u7aef\u672b\u306e\u5bfe\u8c61\u30e6\u30fc\u30b6\u30fcID"
    },
    "target_user_name": {
      "type": "string",
      "default": "",
      "description": "\u500b\u4eba\u7528\u7aef\u672b\u306e\u5bfe\u8c61\u30e6\u30fc\u30b6\u30fc\u540d"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked"
      ],
      "default": "pending",
      "description": "\u767b\u9332\u72b6\u614b\uff08pending=\u8a8d\u8a3c\u5f85\u3061 / active=\u6709\u52b9 / revoked=\u89e3\u9664\u6e08\u307f\uff09"
    },
    "device_info": {
      "type": "string",
      "default": "",
      "description": "\u7aef\u672b\u306e\u30d6\u30e9\u30a6\u30b6\u30fbOS\u60c5\u5831"
    },
    "activated_by_name": {
      "type": "string",
      "default": "",
      "description": "\u8a8d\u8a3c\u5b8c\u4e86\u3057\u305f\u30e6\u30fc\u30b6\u30fc\u540d"
    },
    "registered_by_name": {
      "type": "string",
      "default": "",
      "description": "\u767b\u9332\u8005\uff08\u7ba1\u7406\u8005\uff09\u540d"
    },
    "registered_at_jst": {
      "type": "string",
      "description": "\u767b\u9332\u65e5\u6642\uff08JST YYYY-MM-DD HH:mm\uff09"
    },
    "activated_at_jst": {
      "type": "string",
      "default": "",
      "description": "\u8a8d\u8a3c\u5b8c\u4e86\u65e5\u6642\uff08JST YYYY-MM-DD HH:mm\uff09"
    },
    "revoked_at_jst": {
      "type": "string",
      "default": "",
      "description": "\u89e3\u9664\u65e5\u6642\uff08JST YYYY-MM-DD HH:mm\uff09"
    },
    "last_access_jst": {
      "type": "string",
      "default": "",
      "description": "\u6700\u7d42\u30a2\u30af\u30bb\u30b9\u65e5\u6642\uff08JST YYYY-MM-DD HH:mm\uff09"
    }
  },
  "required": [
    "token",
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}