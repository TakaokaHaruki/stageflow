{
  "name": "PositionBackup",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u30a4\u30d9\u30f3\u30c8ID"
    },
    "label": {
      "type": "string",
      "description": "\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u30e9\u30d9\u30eb",
      "default": ""
    },
    "backup_data": {
      "type": "object",
      "description": "\u30a4\u30d9\u30f3\u30c8\u56fa\u6709\u30c7\u30fc\u30bf\u306e\u30b9\u30ca\u30c3\u30d7\u30b7\u30e7\u30c3\u30c8 {positions, staff, emergency_contacts, event_sheets, announcements, shared_files, side_settings, map_areas, tasks, position_type_overrides}",
      "default": {}
    },
    "position_count": {
      "type": "number",
      "description": "\u30dd\u30b8\u30b7\u30e7\u30f3\u6570\uff08\u4e92\u63db\u7528\uff09",
      "default": 0
    },
    "staff_count": {
      "type": "number",
      "description": "\u30b9\u30bf\u30c3\u30d5\u6570",
      "default": 0
    },
    "summary": {
      "type": "string",
      "description": "\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u6982\u8981\uff08\u4f8b: \u914d\u7f6e16\u30fb\u30b9\u30bf\u30c3\u30d58\u30fb\u304a\u77e5\u3089\u305b3\uff09",
      "default": ""
    },
    "is_auto": {
      "type": "boolean",
      "description": "\u81ea\u52d5\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u304b\u3069\u3046\u304b",
      "default": false
    },
    "created_by_name": {
      "type": "string",
      "description": "\u4f5c\u6210\u8005\u540d",
      "default": ""
    },
    "created_at_jst": {
      "type": "string",
      "description": "\u4f5c\u6210\u65e5\u6642(JST YYYY-MM-DD HH:mm)"
    }
  },
  "required": [
    "event_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    }
  }
}