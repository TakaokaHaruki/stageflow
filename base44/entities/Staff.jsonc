{
  "name": "Staff",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u30a4\u30d9\u30f3\u30c8 ID"
    },
    "name": {
      "type": "string",
      "description": "\u30b9\u30bf\u30c3\u30d5\u540d"
    },
    "acast_id": {
      "type": "string",
      "description": "A\u30ad\u30e3\u30b9\u30c8ID\uff08\u30b9\u30bf\u30c3\u30d5\u30dd\u30fc\u30bf\u30eb\u8a8d\u8a3c\u7528\uff09"
    },
    "gender": {
      "type": "string",
      "enum": [
        "\u7537",
        "\u5973",
        ""
      ],
      "default": "",
      "description": "\u6027\u5225\uff08\u7537/\u5973\u3001\u672a\u8a2d\u5b9a\u53ef\uff09"
    },
    "note": {
      "type": "string",
      "description": "\u5099\u8003\uff08\u5171\u901a\uff09"
    },
    "note_before": {
      "type": "string",
      "description": "\u958b\u5834\u4e2d\u306e\u5099\u8003"
    },
    "note_during": {
      "type": "string",
      "description": "\u958b\u6f14\u4e2d\u306e\u5099\u8003"
    },
    "note_after": {
      "type": "string",
      "description": "\u7d42\u6f14\u5f8c\u306e\u5099\u8003"
    },
    "color": {
      "type": "string",
      "description": "\u8868\u793a\u6587\u5b57\u8272\uff08\u4f8b\uff1a#ff0000\uff09"
    },
    "costume_change": {
      "type": "boolean",
      "description": "\u7740\u66ff\u3048\u30d5\u30e9\u30b0",
      "default": false
    },
    "break": {
      "type": "boolean",
      "description": "\u4f11\u61a9\u30d5\u30e9\u30b0",
      "default": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u6355\u307e\u308a\u30bf\u30b0\uff08\u4f8b\uff1a\u7167\u660e\u3001\u9053\u5177\u3001PA\u3001\u30de\u30a4\u30af\uff09",
      "default": []
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u5f79\u5272\uff08\u4f8b\uff1a\u30a4\u30f3\u30ab\u30e0\u3001\u30bb\u30af\u30b7\u30e7\u30f3\u30c1\u30fc\u30d5\uff09",
      "default": []
    }
  },
  "required": [
    "event_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    }
  }
}