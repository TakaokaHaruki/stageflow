{
  "name": "MeetingSheet",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u30a4\u30d9\u30f3\u30c8ID"
    },
    "title": {
      "type": "string",
      "default": "",
      "description": "\u7528\u7d19\u30bf\u30a4\u30c8\u30eb\uff08\u672a\u5165\u529b\u6642\u306f\u300c\u30df\u30fc\u30c6\u30a3\u30f3\u30b0\u7528\u7d19\u300d\uff09"
    },
    "event_name": {
      "type": "string",
      "default": "",
      "description": "\u516c\u6f14\u540d"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "\u65e5\u7a0b"
    },
    "venue": {
      "type": "string",
      "default": "",
      "description": "\u4f1a\u5834"
    },
    "chief_name": {
      "type": "string",
      "default": "",
      "description": "\u30c1\u30fc\u30d5\u540d\uff08PDF\u30d8\u30c3\u30c0\u30fc\u7528\u30fb\u30a4\u30d9\u30f3\u30c8\u65e2\u5b9a\u5024\u304b\u3089\u88dc\u5b8c\u53ef\uff09"
    },
    "cloak_name": {
      "type": "string",
      "default": "",
      "description": "\u30af\u30ed\u30fc\u30af\u540d\uff08PDF\u30d8\u30c3\u30c0\u30fc\u7528\u30fb\u30a4\u30d9\u30f3\u30c8\u65e2\u5b9a\u5024\u304b\u3089\u88dc\u5b8c\u53ef\uff09"
    },
    "time_priority": {
      "type": "string",
      "default": "",
      "description": "\u5148\u884c\u8ca9\u58f2\u6642\u9593\uff08\u4f8b: 15:00-15:45\uff09"
    },
    "time_open": {
      "type": "string",
      "default": "",
      "description": "\u958b\u5834\u6642\u9593"
    },
    "time_start": {
      "type": "string",
      "default": "",
      "description": "\u958b\u6f14\u6642\u9593"
    },
    "time_end": {
      "type": "string",
      "default": "",
      "description": "\u7d42\u6f14\u6642\u9593"
    },
    "time_note": {
      "type": "string",
      "default": "",
      "description": "\u30bf\u30a4\u30e0\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u5099\u8003"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "\u672c\u6587\u30bb\u30af\u30b7\u30e7\u30f3\uff08\u9806\u5e8f\u30fb\u30bf\u30a4\u30c8\u30eb\u7de8\u96c6\u30fb\u8ffd\u52a0\u524a\u9664\u30fb\u30ea\u30c3\u30c1\u30c6\u30ad\u30b9\u30c8\u672c\u6587\uff09 [{id, label, content(HTML)}]\u3002\u7a7a\u6642\u306f\u5f93\u6765\u306e\u56fa\u5b9a\u9805\u76ee\u3092\u53c2\u7167"
    },
    "applied_template_id": {
      "type": "string",
      "default": "",
      "description": "\u6700\u5f8c\u306b\u9069\u7528\u3057\u305f\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8ID\uff08\u53c2\u7167\u7528\uff09"
    },
    "ticket": {
      "type": "string",
      "default": "",
      "description": "\u30c1\u30b1\u30c3\u30c8\u95a2\u4fc2\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "reception": {
      "type": "string",
      "default": "",
      "description": "\u95a2\u4fc2\u8005\u53d7\u4ed8\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "goods": {
      "type": "string",
      "default": "",
      "description": "\u30b0\u30c3\u30ba\u8ca9\u58f2\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "cd_sale": {
      "type": "string",
      "default": "",
      "description": "CD\u8ca9\u58f2\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "fanclub": {
      "type": "string",
      "default": "",
      "description": "\u30d5\u30a1\u30f3\u30af\u30e9\u30d6\u65bd\u7b56\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "reentry": {
      "type": "string",
      "default": "",
      "description": "\u518d\u5165\u5834\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "audience_rules": {
      "type": "string",
      "default": "",
      "description": "\u5ba2\u5e2d\u5185\u3067\u306e\u30eb\u30fc\u30eb\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "after_show": {
      "type": "string",
      "default": "",
      "description": "\u7d42\u6f14\u5f8c\u306b\u3064\u3044\u3066\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "gifts": {
      "type": "string",
      "default": "",
      "description": "\u30d7\u30ec\u30bc\u30f3\u30c8\u95a2\u4fc2\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "lost_items": {
      "type": "string",
      "default": "",
      "description": "\u843d\u3068\u3057\u7269\u5bfe\u5fdc\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "luggage": {
      "type": "string",
      "default": "",
      "description": "\u304a\u5ba2\u69d8\u306e\u8377\u7269\u5bfe\u5fdc\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "seating_guide": {
      "type": "string",
      "default": "",
      "description": "\u5ba2\u5e2d\u6848\u5185\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "facilities": {
      "type": "string",
      "default": "",
      "description": "\u5404\u968e\u306e\u8a2d\u5099\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "work_notes": {
      "type": "string",
      "default": "",
      "description": "\u7a3c\u50cd\u306b\u3042\u305f\u3063\u3066\u306e\u6ce8\u610f\u4e8b\u9805\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "emergency": {
      "type": "string",
      "default": "",
      "description": "\u7dca\u6025\u6642\u306e\u5bfe\u5fdc\uff08\u5f93\u6765\u9805\u76ee\u30fb\u4e92\u63db\u7528\uff09"
    },
    "created_by_name": {
      "type": "string",
      "default": "",
      "description": "\u4f5c\u6210\u8005\u540d"
    },
    "updated_at_jst": {
      "type": "string",
      "description": "\u6700\u7d42\u66f4\u65b0\u65e5\u6642(JST YYYY-MM-DD HH:mm)"
    }
  },
  "required": [
    "event_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    }
  }
}