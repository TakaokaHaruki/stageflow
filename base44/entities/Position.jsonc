{
  "name": "Position",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u30a4\u30d9\u30f3\u30c8 ID"
    },
    "name": {
      "type": "string",
      "description": "\u30dd\u30b8\u30b7\u30e7\u30f3\u540d\uff08\u4f8b\uff1a\u53d7\u4ed8 A\u3001\u8a98\u5c0e B\uff09"
    },
    "category": {
      "type": "string",
      "description": "\u5c5e\u6027\uff08PositionType\u304b\u3089\u7d99\u627f\u3001\u500b\u5225\u4e0a\u66f8\u304d\u53ef\uff09",
      "default": ""
    },
    "recommended_gender": {
      "type": "string",
      "enum": [
        "\u7537",
        "\u5973",
        ""
      ],
      "default": "",
      "description": "\u63a8\u5968\u6027\u5225\uff08\u81ea\u52d5\u914d\u7f6e\u3067\u512a\u5148\u30de\u30c3\u30c1\u30f3\u30b0\uff09"
    },
    "time_slot": {
      "type": "string",
      "enum": [
        "\u958b\u5834\u4e2d",
        "\u958b\u6f14\u4e2d",
        "\u7d42\u6f14\u5f8c",
        "\u901a\u3057"
      ],
      "default": "\u958b\u5834\u4e2d",
      "description": "\u6642\u9593\u5e2f\u533a\u5206"
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "\u6240\u5c5e\u516c\u6f14\u90e8\u756a\u53f7\u30ea\u30b9\u30c8\uff08\u8907\u6570\u516c\u6f14\u30e2\u30fc\u30c9\u6642\uff09\u3002\u8907\u6570\u542b\u3080\u3068\u90e8\u9593\u540c\u671f\uff081\u30ec\u30b3\u30fc\u30c9\u3092\u5171\u6709\uff09",
      "default": []
    },
    "staff_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u62c5\u5f53\u30b9\u30bf\u30c3\u30d5\u540d\u30ea\u30b9\u30c8",
      "default": []
    },
    "staff_names_kamite": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u4e0a\u624b\u5074\u306e\u62c5\u5f53\u30b9\u30bf\u30c3\u30d5\u540d\u30ea\u30b9\u30c8",
      "default": []
    },
    "staff_names_shimote": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u4e0b\u624b\u5074\u306e\u62c5\u5f53\u30b9\u30bf\u30c3\u30d5\u540d\u30ea\u30b9\u30c8",
      "default": []
    },
    "split_by_side": {
      "type": "boolean",
      "description": "\u4e0a\u624b\u30fb\u4e0b\u624b\u3067\u30b9\u30bf\u30c3\u30d5\u914d\u7f6e\u3092\u5206\u3051\u308b",
      "default": false
    },
    "notes": {
      "type": "string",
      "description": "\u5099\u8003"
    },
    "map_x": {
      "type": "number",
      "description": "\u30de\u30c3\u30d7\u4e0a\u306e X \u5ea7\u6a19\uff08%\uff09"
    },
    "map_y": {
      "type": "number",
      "description": "\u30de\u30c3\u30d7\u4e0a\u306e Y \u5ea7\u6a19\uff08%\uff09"
    },
    "map_x_kamite": {
      "type": "number",
      "description": "\u4e0a\u624b\u30d4\u30f3\u306e X \u5ea7\u6a19\uff08%\uff09"
    },
    "map_y_kamite": {
      "type": "number",
      "description": "\u4e0a\u624b\u30d4\u30f3\u306e Y \u5ea7\u6a19\uff08%\uff09"
    },
    "map_x_shimote": {
      "type": "number",
      "description": "\u4e0b\u624b\u30d4\u30f3\u306e X \u5ea7\u6a19\uff08%\uff09"
    },
    "map_y_shimote": {
      "type": "number",
      "description": "\u4e0b\u624b\u30d4\u30f3\u306e Y \u5ea7\u6a19\uff08%\uff09"
    },
    "color": {
      "type": "string",
      "description": "\u8868\u793a\u8272"
    },
    "required_count": {
      "type": "number",
      "description": "\u5fc5\u8981\u4eba\u6570\uff08\u3053\u306e\u30a4\u30d9\u30f3\u30c8\u30fb\u3053\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u56fa\u6709\uff09",
      "default": 0
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u81ea\u52d5\u914d\u7f6e\u3067\u512a\u5148\u3059\u308b\u6355\u307e\u308a\u30bf\u30b0\uff08\u4f8b\uff1a\u7167\u660e\u3001\u97f3\u97ff\uff09",
      "default": []
    },
    "required_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u5fc5\u8981\u5f79\u5272\uff08\u81ea\u52d5\u914d\u7f6e\u3067\u512a\u5148\u30de\u30c3\u30c1\u30f3\u30b0\u30fb\u4f8b\uff1a\u30a4\u30f3\u30ab\u30e0\u3001\u30bb\u30af\u30b7\u30e7\u30f3\u30c1\u30fc\u30d5\uff09",
      "default": []
    },
    "chief_name": {
      "type": "string",
      "description": "\u62c5\u5f53\u30bb\u30af\u30b7\u30e7\u30f3\u30c1\u30fc\u30d5\u540d\uff08\u30dd\u30b8\u30b7\u30e7\u30f3\u5358\u4f4d\u306e\u8cac\u4efb\u8005\uff09",
      "default": ""
    },
    "chief_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u62c5\u5f53\u30bb\u30af\u30b7\u30e7\u30f3\u30c1\u30fc\u30d5\u540d\u30ea\u30b9\u30c8\uff08\u8907\u6570\u9078\u629e\u53ef\u30fb\u30dd\u30b8\u30b7\u30e7\u30f3\u6240\u5c5e\u30b9\u30bf\u30c3\u30d5\u304b\u3089\u9078\u629e\uff09",
      "default": []
    },
    "order": {
      "type": "number",
      "description": "\u8868\u793a\u9806",
      "default": 0
    },
    "added_by": {
      "type": "string",
      "description": "QR\u8aad\u53d6\u3067\u8ffd\u52a0\u3057\u305f\u30bb\u30af\u30b7\u30e7\u30f3\u30c1\u30fc\u30d5\u540d\uff08\u76f4\u8fd1\u8ffd\u52a0\u306e\u307f\u8a18\u9332\uff09"
    },
    "added_at_jst": {
      "type": "string",
      "description": "QR\u8aad\u53d6\u3067\u8ffd\u52a0\u3057\u305f\u65e5\u6642\uff08JST\u3001YYYY-MM-DD HH:mm\uff09"
    }
  },
  "required": [
    "event_id",
    "name",
    "time_slot"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    }
  }
}