{
  "name": "EditingPresence",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u30a4\u30d9\u30f3\u30c8ID"
    },
    "user_id": {
      "type": "string",
      "description": "\u5728\u5e2d\u30e6\u30fc\u30b6\u30fcID"
    },
    "user_name": {
      "type": "string",
      "description": "\u5728\u5e2d\u30e6\u30fc\u30b6\u30fc\u8868\u793a\u540d"
    },
    "role": {
      "type": "string",
      "default": "",
      "description": "\u30ed\u30fc\u30eb(admin/chief/user)"
    },
    "tab": {
      "type": "string",
      "default": "",
      "description": "\u958b\u3044\u3066\u3044\u308b\u30bf\u30d6(staff/dragdrop/settings/admin/files)"
    },
    "last_heartbeat_at_jst": {
      "type": "string",
      "description": "\u6700\u7d42\u30cf\u30fc\u30c8\u30d3\u30fc\u30c8\u6642\u523b(JST YYYY-MM-DD HH:mm:ss)"
    },
    "last_active_at_jst": {
      "type": "string",
      "description": "\u6700\u7d42\u64cd\u4f5c\u6642\u523b(JST YYYY-MM-DD HH:mm:ss)"
    },
    "active_position_id": {
      "type": "string",
      "default": "",
      "description": "\u64cd\u4f5c\u4e2d\u306e\u30dd\u30b8\u30b7\u30e7\u30f3ID"
    },
    "active_staff_name": {
      "type": "string",
      "default": "",
      "description": "\u64cd\u4f5c\u4e2d\u306e\u30b9\u30bf\u30c3\u30d5\u540d"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u5728\u5e2d\u30d5\u30e9\u30b0\uff08OFF\u3067\u96e2\u8131\u6271\u3044\uff09"
    }
  },
  "required": [
    "event_id",
    "user_id",
    "user_name"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}