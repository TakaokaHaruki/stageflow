{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u30a4\u30d9\u30f3\u30c8\u540d"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u958b\u50ac\u65e5"
    },
    "venue": {
      "type": "string",
      "description": "\u4f1a\u5834\u540d"
    },
    "description": {
      "type": "string",
      "description": "\u5099\u8003"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u6e96\u5099\u4e2d",
        "\u958b\u50ac\u4e2d",
        "\u7d42\u4e86"
      ],
      "default": "\u6e96\u5099\u4e2d",
      "description": "\u30b9\u30c6\u30fc\u30bf\u30b9"
    },
    "time_priority": {
      "type": "string",
      "description": "\u5148\u884c\u6642\u9593 (HH:MM \u5f62\u5f0f)"
    },
    "time_priority_end": {
      "type": "string",
      "description": "\u5148\u884c\u7d42\u4e86\u6642\u9593 (HH:MM \u5f62\u5f0f)"
    },
    "time_open": {
      "type": "string",
      "description": "\u958b\u5834\u6642\u9593 (HH:MM \u5f62\u5f0f)"
    },
    "time_open_end": {
      "type": "string",
      "description": "\u958b\u5834\u7d42\u4e86\u6642\u9593 (HH:MM \u5f62\u5f0f)"
    },
    "time_start": {
      "type": "string",
      "description": "\u958b\u6f14\u6642\u9593 (HH:MM \u5f62\u5f0f)"
    },
    "time_start_end": {
      "type": "string",
      "description": "\u958b\u6f14\u7d42\u4e86\u6642\u9593 (HH:MM \u5f62\u5f0f)"
    },
    "time_end": {
      "type": "string",
      "description": "\u7d42\u6f14\u6642\u9593 (HH:MM \u5f62\u5f0f)"
    },
    "time_end_end": {
      "type": "string",
      "description": "\u7d42\u6f14\u7d42\u4e86\u6642\u9593 (HH:MM \u5f62\u5f0f)"
    },
    "map_image_url": {
      "type": "string",
      "description": "\u4f1a\u5834\u30de\u30c3\u30d7\u80cc\u666f\u753b\u50cf URL"
    },
    "map_pdf_url": {
      "type": "string",
      "description": "\u4f1a\u5834\u30de\u30c3\u30d7 PDF URL"
    },
    "active_preset_id": {
      "type": "string",
      "description": "\u9069\u7528\u4e2d\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u30d7\u30ea\u30bb\u30c3\u30c8 ID"
    },
    "scrape_url": {
      "type": "string",
      "description": "\u70b9\u547c\u8868\u53d6\u5f97 URL\uff08\u6700\u5f8c\u306b\u4f7f\u7528\u3057\u305f URL\uff09"
    },
    "scrape_url_history": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u70b9\u547c\u8868\u53d6\u5f97 URL \u306e\u5c65\u6b74\u30ea\u30b9\u30c8"
    },
    "show_map": {
      "type": "boolean",
      "default": false,
      "description": "\u4f1a\u5834\u30de\u30c3\u30d7\u6a5f\u80fd\u306e\u8868\u793a\u30d5\u30e9\u30b0"
    },
    "show_tasks": {
      "type": "boolean",
      "default": true,
      "description": "\u30c1\u30a7\u30c3\u30af\u30ea\u30b9\u30c8\u6a5f\u80fd\u306e\u8868\u793a\u30d5\u30e9\u30b0"
    },
    "locked_staff_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u81ea\u52d5\u914d\u7f6e\u304b\u3089\u9664\u5916\u3059\u308b\u30ed\u30c3\u30af\u6e08\u307f\u30b9\u30bf\u30c3\u30d5\u540d\u30ea\u30b9\u30c8"
    },
    "staff_management_mode": {
      "type": "string",
      "enum": [
        "edit",
        "public"
      ],
      "default": "edit",
      "description": "\u30b9\u30bf\u30c3\u30d5\u7ba1\u7406\u306e\u516c\u958b\u30e2\u30fc\u30c9 (edit=\u7de8\u96c6\u4e2d/\u975e\u516c\u958b\u3001public=\u95b2\u89a7\u516c\u958b)"
    },
    "assignment_mode": {
      "type": "string",
      "enum": [
        "edit",
        "public"
      ],
      "default": "edit",
      "description": "\u914d\u7f6e\u8868\u306e\u516c\u958b\u30e2\u30fc\u30c9 (edit=\u7de8\u96c6\u4e2d/\u975e\u516c\u958b\u3001public=\u95b2\u89a7\u516c\u958b)"
    },
    "venue_map_mode": {
      "type": "string",
      "enum": [
        "edit",
        "public"
      ],
      "default": "edit",
      "description": "\u4f1a\u5834\u30de\u30c3\u30d7\u306e\u516c\u958b\u30e2\u30fc\u30c9 (edit=\u7de8\u96c6\u4e2d/\u975e\u516c\u958b\u3001public=\u95b2\u89a7\u516c\u958b)"
    },
    "continuous_mode": {
      "type": "boolean",
      "default": false,
      "description": "\u4e00\u65e5\u901a\u3057\u30e2\u30fc\u30c9\uff08\u6642\u9593\u5e2f\u533a\u5206\u306a\u3057\u30fb\u5927\u578b\u30d5\u30a7\u30b9\u7b49\uff09"
    },
    "multi_show_mode": {
      "type": "boolean",
      "default": false,
      "description": "\u8907\u6570\u516c\u6f14\u30e2\u30fc\u30c9\uff081\u90e8\u30fcN\u90e8\u306e\u5404\u516c\u6f14\u3054\u3068\u306b\u958b\u5834\u4e2d\u30fb\u958b\u6f14\u4e2d\u30fb\u7d42\u6f14\u5f8c\u3092\u7ba1\u7406\uff09\u3002\u901a\u3057\u30e2\u30fc\u30c9\u3068\u306f\u6392\u4ed6"
    },
    "show_count": {
      "type": "number",
      "default": 1,
      "description": "\u8907\u6570\u516c\u6f14\u30e2\u30fc\u30c9\u6642\u306e\u516c\u6f14\u6570\uff08\u90e8\u6570\uff09"
    },
    "show_sync": {
      "type": "object",
      "description": "\u90e8\u9593\u540c\u671f\u8a2d\u5b9a { \u6642\u9593\u5e2f: [\u540c\u671f\u3059\u308b\u90e8\u756a\u53f7...] }\u3002\u4f8b: {\"\u958b\u5834\u4e2d\": [1,2]}",
      "default": {}
    },
    "show_times": {
      "type": "object",
      "description": "\u90e8\u5225\u306e\u516c\u6f14\u6642\u523b {\"1\": {time_open, time_open_end, time_start, time_start_end, time_end, time_end_end}}\uff08\u8907\u6570\u516c\u6f14\u30e2\u30fc\u30c9\u6642\uff09\u3002\u672a\u8a2d\u5b9a\u306e\u90e8\u306f\u30a4\u30d9\u30f3\u30c8\u5171\u901a\u306e\u6642\u523b\u3092\u4f7f\u7528",
      "default": {}
    },
    "admin_only": {
      "type": "boolean",
      "default": false,
      "description": "\u7ba1\u7406\u8005\u5c02\u7528\u30e2\u30fc\u30c9\uff08ON\u306e\u5834\u5408\u3001\u7ba1\u7406\u8005\u4ee5\u5916\u306f\u30a4\u30d9\u30f3\u30c8\u8a73\u7d30\u30da\u30fc\u30b8\u306b\u30a2\u30af\u30bb\u30b9\u4e0d\u53ef\uff09"
    }
  },
  "required": [
    "name"
  ]
}