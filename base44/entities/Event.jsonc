{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u30a4\u30d9\u30f3\u30c8\u540d"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u958b\u50ac\u65e5"
    },
    "venue": {
      "type": "string",
      "description": "\u4f1a\u5834\u540d"
    },
    "description": {
      "type": "string",
      "description": "\u5099\u8003"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u6e96\u5099\u4e2d",
        "\u958b\u50ac\u4e2d",
        "\u7d42\u4e86"
      ],
      "default": "\u6e96\u5099\u4e2d",
      "description": "\u30b9\u30c6\u30fc\u30bf\u30b9"
    },
    "map_image_url": {
      "type": "string",
      "description": "\u4f1a\u5834\u30de\u30c3\u30d7\u80cc\u666f\u753b\u50cfURL"
    },
    "map_pdf_url": {
      "type": "string",
      "description": "\u4f1a\u5834\u30de\u30c3\u30d7PDF URL"
    },
    "active_preset_id": {
      "type": "string",
      "description": "\u9069\u7528\u4e2d\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u30d7\u30ea\u30bb\u30c3\u30c8ID"
    },
    "scrape_url": {
      "type": "string",
      "description": "\u70b9\u547c\u8868\u53d6\u5f97URL\uff08\u6700\u5f8c\u306b\u4f7f\u7528\u3057\u305fURL\uff09"
    },
    "scrape_url_history": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u70b9\u547c\u8868\u53d6\u5f97URL\u306e\u5c65\u6b74\u30ea\u30b9\u30c8"
    },
    "show_timeline": {
      "type": "boolean",
      "default": false,
      "description": "\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u6a5f\u80fd\u306e\u8868\u793a\u30d5\u30e9\u30b0"
    },
    "show_map": {
      "type": "boolean",
      "default": false,
      "description": "\u4f1a\u5834\u30de\u30c3\u30d7\u6a5f\u80fd\u306e\u8868\u793a\u30d5\u30e9\u30b0"
    },
    "show_tasks": {
      "type": "boolean",
      "default": true,
      "description": "\u30c1\u30a7\u30c3\u30af\u30ea\u30b9\u30c8\u6a5f\u80fd\u306e\u8868\u793a\u30d5\u30e9\u30b0"
    }
  },
  "required": [
    "name"
  ]
}