{
  "name": "AccessLog",
  "type": "object",
  "properties": {
    "page_path": {
      "type": "string",
      "description": "\u30a2\u30af\u30bb\u30b9\u3055\u308c\u305f\u30da\u30fc\u30b8\u30d1\u30b9\uff08\u4f8b: /, /events\uff09"
    },
    "from_path": {
      "type": "string",
      "default": "",
      "description": "\u30a2\u30d7\u30ea\u5185\u306e\u9077\u79fb\u5143\u30d1\u30b9\uff08\u76f4\u63a5\u30a2\u30af\u30bb\u30b9\u6642\u306f\u7a7a\uff09"
    },
    "referrer": {
      "type": "string",
      "default": "",
      "description": "\u5916\u90e8\u53c2\u7167\u5143URL\uff08document.referrer\uff09"
    },
    "referrer_type": {
      "type": "string",
      "enum": [
        "internal",
        "direct",
        "search",
        "sns",
        "external"
      ],
      "default": "direct",
      "description": "\u6d41\u5165\u5143\u5206\u985e\uff08\u30a2\u30d7\u30ea\u5185/\u76f4\u63a5\u30a2\u30af\u30bb\u30b9/\u691c\u7d22/SNS/\u5916\u90e8\u30ea\u30f3\u30af\uff09"
    },
    "query": {
      "type": "string",
      "default": "",
      "description": "URL\u30af\u30a8\u30ea\u30d1\u30e9\u30e1\u30fc\u30bf\uff08\u6d41\u5165\u7d4c\u8def\u7279\u5b9a\u7528\uff09"
    },
    "ip_address": {
      "type": "string",
      "default": "",
      "description": "\u30a2\u30af\u30bb\u30b9\u5143IP\u30a2\u30c9\u30ec\u30b9"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "mobile",
        "tablet",
        "desktop"
      ],
      "default": "desktop",
      "description": "\u30c7\u30d0\u30a4\u30b9\u7a2e\u5225"
    },
    "browser": {
      "type": "string",
      "default": "",
      "description": "\u30d6\u30e9\u30a6\u30b6\uff08Chrome, Safari \u306a\u3069\uff09"
    },
    "os": {
      "type": "string",
      "default": "",
      "description": "OS\uff08iOS, Android, Windows \u306a\u3069\uff09"
    },
    "screen_size": {
      "type": "string",
      "default": "",
      "description": "\u753b\u9762\u30b5\u30a4\u30ba\uff08\u5e45x\u9ad8\u3055\uff09"
    },
    "user_agent": {
      "type": "string",
      "default": "",
      "description": "\u30e6\u30fc\u30b6\u30fc\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8"
    },
    "auth_type": {
      "type": "string",
      "enum": [
        "anonymous",
        "app_user",
        "portal_staff"
      ],
      "default": "anonymous",
      "description": "\u8a8d\u8a3c\u72b6\u6cc1\uff08\u672a\u30ed\u30b0\u30a4\u30f3/\u30a2\u30d7\u30ea\u30ed\u30b0\u30a4\u30f3/\u30dd\u30fc\u30bf\u30eb\u8a8d\u8a3c\uff09"
    },
    "user_email": {
      "type": "string",
      "default": "",
      "description": "\u30a2\u30d7\u30ea\u30ed\u30b0\u30a4\u30f3\u30e6\u30fc\u30b6\u30fc\u306e\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9"
    },
    "user_role": {
      "type": "string",
      "default": "",
      "description": "\u30a2\u30d7\u30ea\u30ed\u30b0\u30a4\u30f3\u30e6\u30fc\u30b6\u30fc\u306e\u30ed\u30fc\u30eb"
    },
    "portal_acast_id": {
      "type": "string",
      "default": "",
      "description": "\u30dd\u30fc\u30bf\u30eb\u8a8d\u8a3c\u6e08\u307f\u30b9\u30bf\u30c3\u30d5\u306eA-CAST ID"
    },
    "visitor_id": {
      "type": "string",
      "default": "",
      "description": "\u7aef\u672b\u5358\u4f4d\u306e\u6c38\u7d9a\u8a2a\u554f\u8005ID"
    },
    "session_id": {
      "type": "string",
      "default": "",
      "description": "\u8a2a\u554f\u5358\u4f4d\u306e\u30bb\u30c3\u30b7\u30e7\u30f3ID\uff0830\u5206\u7121\u64cd\u4f5c\u3067\u5207\u66ff\uff09"
    },
    "stay_seconds": {
      "type": "number",
      "default": 0,
      "description": "\u3053\u306e\u30da\u30fc\u30b8\u306e\u6ede\u5728\u79d2\u6570\uff08\u6b21\u306e\u9077\u79fb\u30fb\u96e2\u8131\u6642\u306b\u78ba\u5b9a\uff09"
    },
    "logged_at_jst": {
      "type": "string",
      "description": "\u30a2\u30af\u30bb\u30b9\u65e5\u6642\uff08JST YYYY-MM-DD HH:mm\uff09"
    }
  },
  "required": [
    "page_path",
    "logged_at_jst"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}