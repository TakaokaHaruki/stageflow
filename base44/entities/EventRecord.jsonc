{
  "name": "EventRecord",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u30a4\u30d9\u30f3\u30c8ID"
    },
    "event_name": {
      "type": "string",
      "default": "",
      "description": "\u30a4\u30d9\u30f3\u30c8\u540d\uff08\u5c65\u6b74\u4e00\u89a7\u306e\u8868\u793a\u7528\uff09"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "\u30a4\u30d9\u30f3\u30c8\u958b\u50ac\u65e5\uff08\u5c65\u6b74\u4e00\u89a7\u306e\u4e26\u3073\u66ff\u3048\u30fb\u898b\u51fa\u3057\u7528\uff09"
    },
    "category": {
      "type": "string",
      "enum": [
        "\u4f1a\u5834",
        "\u904b\u55b6",
        "\u30b9\u30bf\u30c3\u30d5",
        "\u6a5f\u6750",
        "\u30c8\u30e9\u30d6\u30eb",
        "\u305d\u306e\u4ed6"
      ],
      "default": "\u305d\u306e\u4ed6",
      "description": "\u8a18\u9332\u30ab\u30c6\u30b4\u30ea"
    },
    "memo": {
      "type": "string",
      "default": "",
      "description": "\u30c6\u30ad\u30b9\u30c8\u30e1\u30e2"
    },
    "photo_uris": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u6dfb\u4ed8\u5199\u771f\u306e\u975e\u516c\u958b\u30b9\u30c8\u30ec\u30fc\u30b8URI"
    },
    "author_name": {
      "type": "string",
      "default": "",
      "description": "\u6295\u7a3f\u8005\u306e\u8868\u793a\u540d"
    }
  },
  "required": [
    "event_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}