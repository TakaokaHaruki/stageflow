{
  "name": "EventSheet",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u30a4\u30d9\u30f3\u30c8 ID"
    },
    "custom_notes": {
      "type": "string",
      "description": "\u6ce8\u610f\u4e8b\u9805\uff08\u624b\u52d5\u5165\u529b\uff09"
    }
  },
  "required": [
    "event_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    }
  }
}