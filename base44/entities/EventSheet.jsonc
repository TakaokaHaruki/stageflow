{
  "name": "EventSheet",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "\u30a4\u30d9\u30f3\u30c8 ID"
    },
    "performance_info": {
      "type": "string",
      "description": "\u516c\u6f14\u60c5\u5831\uff08\u8ffd\u52a0\u30fb\u88dc\u8db3\uff09"
    },
    "precautions": {
      "type": "string",
      "description": "\u6ce8\u610f\u4e8b\u9805\uff08Markdown \u5f62\u5f0f\uff09"
    },
    "custom_header": {
      "type": "string",
      "description": "\u30ab\u30b9\u30bf\u30e0\u30d8\u30c3\u30c0\u30fc\uff08\u4efb\u610f\uff09"
    }
  },
  "required": [
    "event_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "chief"
          }
        }
      ]
    }
  }
}